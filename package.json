{
  "name": "contentdock",
  "version": "1.0.0",
  "private": true,
  "description": "ContentDock — Plateforme locale autonome de capture et planification de contenus (Desktop & Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node copy-build-assets.js",
    "desktop:dev": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && tauri dev",
    "desktop:build": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && tauri build",
    "cap:sync": "npx cap sync",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/device": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tauri-apps/cli": "^2.8.3",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^6.0.3"
  }
}
